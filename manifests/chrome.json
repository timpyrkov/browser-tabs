{
  "manifest_version": 3,
  "name": "Tab History for Long-Open Tabs",
  "version": "2.0",
  "description": "Keeps a history of tabs that stayed open for days: how long each was open, searchable and sortable in a side panel.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Tab History"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  }
}
